{# ============================================================
   Critical Earth — outer page skeleton.
   Generated by pipeline/build/build_index.py from content/site.yaml
   plus content/sections/*.yaml. Do NOT edit website/index.html by hand.
   ============================================================ #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.title }}</title>
  <meta name="description" content="{{ site.description }}">
  <link rel="stylesheet" href="css/critical-earth.css?v={{ asset_version }}">
  <link rel="stylesheet" href="css/site.css?v={{ asset_version }}">
</head>
<body>
  {% include "blocks/chrome.html.j2" %}

  <main id="top">
    {% include "blocks/hero.html.j2" %}

    {% for section in site.sections %}
      {% set section_class = section.class | default('') %}
      {% for block in section.blocks %}
        {% set block = block %}{# expose to nested includes #}
        {% set section_id = section.id | default(none) %}
        {% set section_class_default = section_class %}
        {% include "blocks/" ~ block.type ~ ".html.j2" %}
      {% endfor %}
    {% endfor %}
  </main>

  {% include "blocks/footer.html.j2" %}

  <script src="data/story_context.js"></script>
  <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
  <script src="js/main.js"></script>
</body>
</html>
