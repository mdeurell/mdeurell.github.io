{# Prose block: a `.longform` section with a narrow `.longform-inner` column.
   YAML fields:
     - id           (optional) — anchor id on the wrapping <section>
     - eyebrow      (optional) — small caption above the heading ("Section 2 · …")
     - heading      (optional) — H2 title
     - dropcap      (optional bool, default true if first paragraph is long enough)
                    — applies .dropcap class to the first <p>
     - text         (required) — markdown body. Multiple paragraphs OK.
     - class        (optional) — extra modifier (e.g. "longform--econ")
     - rule_after   (optional bool) — append <hr class="longform-rule"> at the end
     - standfirst_after (optional) — markdown of a closing `.standfirst` paragraph
#}
{# block.class overrides; otherwise inherit section.class. Avoids duplication. #}
{% set extra_class = block.class if block.class else (section.class | default('')) %}
{% set class_attr = ('longform ' ~ extra_class) | trim %}
<section class="{{ class_attr }}"{% if block.id %} id="{{ block.id }}"{% endif %}>
  <div class="longform-inner">
    {% if block.eyebrow %}
    <p class="caption">{{ block.eyebrow | safe }}</p>
    {% endif %}
    {% if block.heading %}
    <h2>{{ block.heading | safe }}</h2>
    {% endif %}

    {# Body: render markdown then optionally wrap first <p> with .dropcap. #}
    {% set body_html = block.text | md %}
    {% if block.dropcap is not defined or block.dropcap %}
      {% set body_html = body_html | replace('<p>', '<p class="dropcap">', 1) %}
    {% endif %}

    {# Margin factboxes: rendered as right-floated <aside> blocks. Each is
       absorbed from a factbox YAML block that immediately followed this
       prose (see build_index._absorb_margin_factboxes). We splice them in
       before the paragraph at ~2/3 of the body so the page text wraps
       around them like a magazine pull-quote.
    #}
    {% if block.margin_factboxes %}
      {% set asides = [] %}
      {% for fb in block.margin_factboxes %}
        {% set tone = fb.tone | default('neutral') %}
        {% set aside_html %}
          <aside class="factbox factbox--margin factbox--{{ tone }}">
            {% if fb.heading %}<p class="factbox-heading">{{ fb.heading | safe }}</p>{% endif %}
            <div class="factbox-body">{{ fb.body | md | safe }}</div>
          </aside>
        {% endset %}
        {% set _ = asides.append(aside_html) %}
      {% endfor %}
      {# Count <p> tags, insert before the one at floor(2/3 * n), min 1. #}
      {% set p_count = body_html.count('<p') %}
      {% set insert_at = [1, ((p_count * 2) // 3)] | max %}
      {% set parts = body_html.split('<p', insert_at + 1) %}
      {% if parts | length > insert_at %}
        {% set head = parts[:insert_at] | join('<p') %}
        {% set tail = '<p' ~ parts[insert_at:] | join('<p') %}
        {{ head | safe }}
        {% for a in asides %}{{ a | safe }}{% endfor %}
        {{ tail | safe }}
      {% else %}
        {{ body_html | safe }}
        {% for a in asides %}{{ a | safe }}{% endfor %}
      {% endif %}
    {% else %}
      {{ body_html | safe }}
    {% endif %}

    {% if block.rule_after %}
    <hr class="longform-rule">
    {% endif %}

    {% if block.standfirst_after %}
    <p class="standfirst">{{ block.standfirst_after | md_inline | safe }}</p>
    {% endif %}
  </div>
</section>
