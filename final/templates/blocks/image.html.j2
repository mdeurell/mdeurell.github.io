{# Static image with the same Prussian-blue-framed caption as a figure.
   YAML fields:
     - src, alt (required)
     - figure_number, caption (optional)
     - aspect (optional, e.g. '16/9') — applied via inline style on the wrapper
     - bleed (optional bool)
#}
{% set bleed = block.bleed if block.bleed is defined else true %}
{% set section_class = block.section_class | default(section.class | default('')) %}
{% set story_class = ('story-section ' ~ section_class) | trim %}
{% set article_classes = ['viz-card'] %}
{% if bleed %}{% set _ = article_classes.append('viz-bleed') %}{% endif %}
{% set _ = article_classes.append('is-frameless') %}

<section class="{{ story_class }}"{% if block.aria_label %} aria-label="{{ block.aria_label }}"{% endif %}>
  <div class="content-wide section-shell">
    <article class="{{ article_classes | join(' ') }}">
      <img class="viz-frame"
           src="{{ block.src }}"
           alt="{{ block.alt }}"
           {% if block.aspect %}style="aspect-ratio: {{ block.aspect }}; object-fit: cover;"{% endif %}
           loading="lazy">
    </article>
  </div>
</section>

{% if block.caption %}
<section class="longform figure-caption-section">
  <p class="figure-caption">
    {% if block.figure_number %}<strong>{{ block.figure_number }}.</strong> {% endif %}
    {{ block.caption | md_inline | safe }}
  </p>
</section>
{% endif %}
