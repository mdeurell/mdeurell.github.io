{# Animation block with toggle controls (e.g. Fig 6: Exports / Imports switch).
   YAML fields:
     - aria_label
     - frame_id              — id on the iframe (for JS to swap src)
     - default_src           — initial iframe src
     - alt
     - frame_class           (optional) — e.g. 'tall-frame'
     - toggles: list of { label, flow, src, active (bool) }
                Each renders a button; data-flow + data-target wired up by main.js
     - figure_number, caption, caption_footnote_id
#}
{% set section_class = block.section_class | default(section.class | default('')) %}
{% set story_class = ('story-section ' ~ section_class) | trim %}
{% set frame_class_attr = (' ' ~ block.frame_class) if block.frame_class else '' %}

<section class="{{ story_class }}"{% if block.aria_label %} aria-label="{{ block.aria_label }}"{% endif %}>
  <div class="content-wide section-shell">
    {% if block.toggles %}
    <div class="flow-toggle" role="tablist" aria-label="Trade direction">
      {% for t in block.toggles %}
      <button type="button"
              class="flow-toggle-btn{% if t.active %} is-active{% endif %}"
              data-flow="{{ t.flow }}"
              data-target="{{ block.frame_id }}"
              role="tab"
              aria-selected="{{ 'true' if t.active else 'false' }}">{{ t.label }}</button>
      {% endfor %}
    </div>
    {% endif %}
    <article class="viz-card viz-bleed is-frameless">
      <iframe
        id="{{ block.frame_id }}"
        class="viz-frame{{ frame_class_attr }}"
        src="{{ block.default_src }}"
        {% for t in block.toggles %}data-src-{{ t.flow }}="{{ t.src }}" {% endfor %}
        title="{{ block.title | default(block.alt | default('Animation')) }}"
        loading="lazy"
      ></iframe>
    </article>
  </div>
</section>

<section class="longform figure-caption-section"{% if block.caption_id %} id="{{ block.caption_id }}"{% endif %}>
  <p class="figure-caption">
    {% if block.figure_number %}<strong>{{ block.figure_number }}.</strong> {% endif %}
    {{ block.caption | md_inline | safe }}
    {% if block.caption_footnote_id %}<span id="{{ block.caption_footnote_id }}" class="footnote-inline"></span>{% endif %}
  </p>
</section>
