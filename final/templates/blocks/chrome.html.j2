{# Site header: wordmark + nav + notebook button. site.nav drives the links. #}
<header class="site-chrome">
  <div class="content-wide chrome-inner">
    <a class="wordmark" href="#top">{{ site.wordmark | default('Critical Earth') }}</a>
    <nav class="section-nav" aria-label="Primary">
      {% for item in site.nav %}
        <a href="{{ item.href }}">{{ item.label }}</a>
      {% endfor %}
    </nav>
    <a class="btn btn-outline js-notebook-link"
       href="{{ site.notebook_href | default('explainer_notebook.ipynb') }}">Open notebook</a>
  </div>
</header>
